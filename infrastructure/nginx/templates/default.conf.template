# Templated by nginx's own docker-entrypoint (envsubst on *.template files,
# built into the official nginx image — no custom entrypoint script needed)
# using the ${DOMAIN} env var set in infrastructure/compose.prod.yaml.
# Three server names per agent.md §27: app.<domain> (customer web),
# staff.<domain> (staff web/KDS/admin), api.<domain> (backend REST/SSE).

# Resolve upstream hostnames per-request via Docker's embedded DNS (127.0.0.11)
# rather than once at nginx startup: a plain `proxy_pass http://backend:8080`
# bakes in whatever IP `backend` resolved to when nginx last loaded its
# config, so a restarted/recreated backend container (new IP) would silently
# 502 until nginx itself was reloaded. The $upstream_* variable form defers
# resolution to request time using this resolver instead.
resolver 127.0.0.11 valid=10s;

# Plain HTTP: only serves the ACME HTTP-01 challenge for certbot, everything
# else redirects to HTTPS. Must keep working even before a certificate
# exists yet (infrastructure/scripts/init-letsencrypt.sh's first run).
server {
    listen 80;
    server_name app.${DOMAIN} staff.${DOMAIN} api.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    limit_req zone=api_general burst=20 nodelay;

    set $upstream_customer_web customer-web:80;

    location / {
        proxy_pass http://$upstream_customer_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name staff.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    limit_req zone=api_general burst=20 nodelay;

    set $upstream_staff_web staff-web:80;

    location / {
        proxy_pass http://$upstream_staff_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    client_max_body_size 1m;

    set $upstream_backend backend:8080;

    # Tighter bucket for credential/checkout endpoints (brute-force /
    # duplicate-order-attempt mitigation) than general catalog/config reads.
    location ~ ^/api/v1/(customers/login|staff/login|orders)$ {
        limit_req zone=api_auth burst=5 nodelay;
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSE stream: disable proxy buffering so events flush immediately rather
    # than sitting in nginx's buffer (agent.md §17 — the KDS depends on
    # timely delivery even though it treats every event as "go refetch").
    location /api/v1/kitchen/stream {
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        limit_req zone=api_general burst=20 nodelay;
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
