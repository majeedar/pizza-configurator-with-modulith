# Copy to .env and fill in real values. Never commit .env.
# See data/agent.md §24 for the full rationale behind each variable.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pizzaconfigurator
DB_USER=pizzaconfigurator
DB_PASSWORD=pizzaconfigurator

# AI Adapter — Deepseek primary, OpenAI fallback (agent.md §7.4). Leave the
# API keys blank locally: DeepseekClient/OpenAiClient stub the call (never
# attempt the HTTP request) rather than fail on a missing key, going
# straight to MANUAL_REVIEW_REQUIRED for any commented order. *_BASE_URL is
# rarely needed outside tests (WireMock overrides it there).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
OPENAI_BASE_URL=https://api.openai.com/v1

# Auth — app-managed JWT (customer login since Phase 5, staff login since
# Phase 7). Local/dev falls back to an insecure baked-in secret if unset —
# production MUST set a real one.
JWT_SIGNING_SECRET=
JWT_ISSUER=pizza-configurator
JWT_AUDIENCE=pizza-configurator-clients

# Notifications (agent.md §7.9). Leave blank locally — both providers stub
# the send instead of connecting (see README "Notifications").
NOTIFICATION_PROVIDER=gmail-smtp
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_BASE_URL=http://localhost:8080

# Local Compose only — override if the default port is already taken on
# your machine (customer-web/staff-web listen on these host ports, container
# port 80 in both cases).
CUSTOMER_WEB_PORT=3000
STAFF_WEB_PORT=3001
